{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "strict": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@llm-transformer-diy/gpu": ["packages/gpu/src/index.ts"],
      "@llm-transformer-diy/tensor": ["packages/tensor/src/index.ts"],
      "@llm-transformer-diy/autograd": ["packages/autograd/src/index.ts"],
      "@llm-transformer-diy/io": ["packages/io/src/index.ts"],
      "@llm-transformer-diy/tokenizer": ["packages/tokenizer/src/index.ts"],
      "@llm-transformer-diy/model": ["packages/model/src/index.ts"],
      "@llm-transformer-diy/inference": ["packages/inference/src/index.ts"],
      "@llm-transformer-diy/training": ["packages/training/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
