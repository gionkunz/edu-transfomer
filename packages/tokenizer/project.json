{
  "name": "@llm-transformer-diy/tokenizer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/tokenizer/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/packages/tokenizer"],
      "options": {
        "outputPath": "dist/packages/tokenizer",
        "main": "packages/tokenizer/src/index.ts",
        "tsConfig": "packages/tokenizer/tsconfig.lib.json",
        "packageJson": "packages/tokenizer/package.json",
        "generatePackageJson": true,
        "assets": ["packages/tokenizer/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:tokenizer", "type:lib"]
}
