{
  "name": "@llm-transformer-diy/io",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/io/src",
  "targets": {
    "compile": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/io/dist",
        "main": "packages/io/src/index.ts",
        "rootDir": "packages/io/src",
        "tsConfig": "packages/io/tsconfig.build.json",
        "generatePackageJson": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "compile"],
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node tools/patch-dist-esm-imports.mjs"
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:io", "type:lib"]
}
