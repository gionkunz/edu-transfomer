{
  "name": "@llm-transformer-diy/io",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/io/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/packages/io"],
      "options": {
        "outputPath": "dist/packages/io",
        "main": "packages/io/src/index.ts",
        "tsConfig": "packages/io/tsconfig.lib.json",
        "packageJson": "packages/io/package.json",
        "generatePackageJson": true,
        "assets": ["packages/io/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:io", "type:lib"]
}
