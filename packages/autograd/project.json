{
  "name": "@llm-transformer-diy/autograd",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/autograd/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/packages/autograd"],
      "options": {
        "outputPath": "dist/packages/autograd",
        "main": "packages/autograd/src/index.ts",
        "tsConfig": "packages/autograd/tsconfig.lib.json",
        "packageJson": "packages/autograd/package.json",
        "generatePackageJson": true,
        "assets": ["packages/autograd/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:autograd", "type:lib"]
}
