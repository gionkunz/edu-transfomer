{
  "name": "@llm-transformer-diy/tensor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/tensor/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/tensor/dist",
        "main": "packages/tensor/src/index.ts",
        "rootDir": "packages/tensor/src",
        "tsConfig": "packages/tensor/tsconfig.json",
        "generatePackageJson": false
      }
    }
  },
  "tags": ["layer:tensor", "type:lib"]
}
