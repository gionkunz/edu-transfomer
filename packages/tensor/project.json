{
  "name": "@llm-transformer-diy/tensor",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/tensor/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/packages/tensor"],
      "options": {
        "outputPath": "dist/packages/tensor",
        "main": "packages/tensor/src/index.ts",
        "tsConfig": "packages/tensor/tsconfig.lib.json",
        "packageJson": "packages/tensor/package.json",
        "generatePackageJson": true,
        "assets": ["packages/tensor/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:tensor", "type:lib"]
}
