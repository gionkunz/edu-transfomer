{
  "name": "@llm-transformer-diy/inference",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/inference/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/packages/inference"],
      "options": {
        "outputPath": "dist/packages/inference",
        "main": "packages/inference/src/index.ts",
        "tsConfig": "packages/inference/tsconfig.lib.json",
        "packageJson": "packages/inference/package.json",
        "generatePackageJson": true,
        "assets": ["packages/inference/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:inference", "type:lib"]
}
