{
  "name": "@llm-transformer-diy/gpu",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/gpu/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/packages/gpu"],
      "options": {
        "outputPath": "dist/packages/gpu",
        "main": "packages/gpu/src/index.ts",
        "tsConfig": "packages/gpu/tsconfig.lib.json",
        "packageJson": "packages/gpu/package.json",
        "generatePackageJson": true,
        "assets": [
          "packages/gpu/*.md",
          {
            "glob": "*.wgsl",
            "input": "packages/gpu/src/kernels",
            "output": "kernels"
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:gpu", "type:lib"]
}
