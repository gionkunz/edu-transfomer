{
  "name": "@llm-transformer-diy/gpu",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/gpu/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/gpu/dist",
        "main": "packages/gpu/src/index.ts",
        "rootDir": "packages/gpu/src",
        "tsConfig": "packages/gpu/tsconfig.build.json",
        "generatePackageJson": false,
        "assets": [
          {
            "glob": "*.wgsl",
            "input": "packages/gpu/src/kernels",
            "output": "kernels"
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:gpu", "type:lib"]
}
