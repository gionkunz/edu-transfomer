{
  "name": "@llm-transformer-diy/training",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/training/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/packages/training"],
      "options": {
        "outputPath": "dist/packages/training",
        "main": "packages/training/src/index.ts",
        "tsConfig": "packages/training/tsconfig.lib.json",
        "packageJson": "packages/training/package.json",
        "generatePackageJson": true,
        "assets": ["packages/training/*.md"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["layer:training", "type:lib"]
}
