{
  "name": "@llm-transformer-diy/cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cli/src",
  "targets": {
    "_esbuild": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{workspaceRoot}/dist/apps/cli"],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/cli",
        "format": ["cjs"],
        "bundle": false,
        "main": "apps/cli/src/main.ts",
        "tsConfig": "apps/cli/tsconfig.app.json",
        "assets": [
          "apps/cli/src/assets",
          {
            "glob": "*.wgsl",
            "input": "packages/gpu/src/kernels",
            "output": "packages/gpu/src/kernels"
          }
        ],
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": { ".js": ".js" }
        },
        "thirdParty": false
      },
      "configurations": {
        "development": {},
        "production": {
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": { ".js": ".js" }
          }
        }
      }
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["_esbuild", "fix-cli-bootstrap-shebang"]
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["_esbuild"],
      "options": {
        "buildTarget": "@llm-transformer-diy/cli:_esbuild",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "@llm-transformer-diy/cli:_esbuild:development"
        },
        "production": {
          "buildTarget": "@llm-transformer-diy/cli:_esbuild:production"
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["_esbuild"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/cli/package.json",
        "{workspaceRoot}/dist/apps/cli/package-lock.json"
      ],
      "options": {
        "buildTarget": "@llm-transformer-diy/cli:_esbuild"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["_esbuild"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/cli/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "@llm-transformer-diy/cli:_esbuild"
      }
    },
    "fix-cli-bootstrap-shebang": {
      "executor": "nx:run-commands",
      "dependsOn": ["_esbuild"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tools/cli-bootstrap-shebang.mjs",
        { "dependentTasksOutputFiles": "**/*", "transitive": false }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/cli/main.js"],
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": ["node ./tools/cli-bootstrap-shebang.mjs dist/apps/cli/main.js"],
        "parallel": false
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules", "fix-cli-bootstrap-shebang"],
      "executor": "nx:noop"
    },
    "test": {
      "executor": "@nx/vitest:test"
    }
  },
  "tags": ["type:app"]
}
