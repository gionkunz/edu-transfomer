{
  "name": "llm-transformer-diy",
  "private": true,
  "description": "Educational transformer stack (TypeScript, WebGPU WGSL, autograd) — monorepo root",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "nx run-many -t build --all",
    "test": "nx run-many -t test --all",
    "test:vitest": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cli:install-dist": "npm install --prefix dist/apps/cli",
    "cli:link-global": "nx run @llm-transformer-diy/cli:prune && npm install --prefix dist/apps/cli && (cd dist/apps/cli && npm link)",
    "cli:unlink-global": "npm unlink -g @llm-transformer-diy/cli"
  },
  "dependencies": {
    "@llm-transformer-diy/cli": "file:apps/cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nx/esbuild": "22.7.1",
    "@nx/eslint": "22.7.1",
    "@nx/js": "22.7.1",
    "@nx/node": "22.7.1",
    "@nx/vite": "22.7.1",
    "@nx/vitest": "22.7.1",
    "@types/react": "^19.2.14",
    "@webgpu/types": "^0.1.69",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.19.18",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.1",
    "prettier": "^3.7.4",
    "tslib": "^2.3.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.5",
    "vite": "6.3.5",
    "vitest": "^3.2.4"
  }
}
